<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="JsonDictionaryEditor.Controls.KVPairEditor"
             Margin="0,5" Background="#40888888" Padding="10" CornerRadius="10">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock>
      Key
    </TextBlock>
    <TextBlock Grid.Row="1">
      Value
    </TextBlock>
    <TextBox Name="KeyBox" Grid.Column="1"/>
    <TextBox Name="ValueBox" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" AcceptsReturn="True"/>
    <Button Grid.Column="2" VerticalAlignment="Stretch" Name="RemoveBtn"
            Click="RemoveBtn_Click"
            VerticalContentAlignment="Center" Padding="0"
            HorizontalContentAlignment="Center" Width="50">-</Button>
  </Grid>
</UserControl>
